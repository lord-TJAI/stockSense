# ─────────────────────────────────────────────────────────────────────────────
# StockSense Frontend — Environment Variables
# Copy to .env.local (Vite reads this automatically in dev).
# Set these as Vercel Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# The full URL of the deployed backend API (no trailing slash).
# Development: http://localhost:5000
# Production: your Render service URL, e.g. https://stocksense-api.onrender.com
VITE_API_URL=http://localhost:5000
