# ─────────────────────────────────────────────────────────────────────────────
# StockSense Backend — Environment Variables
# Copy to .env and fill in all values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development          # production | development | test
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# The dbName option in db.js overrides the database name segment to 'stocksense'.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stocksense?appName=Cluster0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_WITH_64_RANDOM_BYTES
JWT_REFRESH_SECRET=REPLACE_ME_WITH_DIFFERENT_64_RANDOM_BYTES
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Step 1: deploy backend → get Render URL
# Step 2: deploy frontend (pointing at Render URL) → get Vercel URL
# Step 3: paste Vercel URL here and redeploy backend
CLIENT_URLS=http://localhost:5173,https://YOUR_APP.vercel.app

# ── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=mock        → OTPs logged to console (development default)
# EMAIL_PROVIDER=smtp        → real SMTP delivery
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@stocksense.dev

# ── Cloudinary (optional — product images) ────────────────────────────────────
# Leave blank to use local-disk fallback (files saved to backend/src/uploads/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
