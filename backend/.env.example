PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stocksense?appName=Cluster0
JWT_ACCESS_SECRET=change_me_to_a_64_char_random_string_replace_before_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_string_replace_before_production
JWT_REFRESH_EXPIRY=7d
NODE_ENV=development

# Email (set EMAIL_PROVIDER=mock to skip real sending; dev default is mock — logs to console)
EMAIL_PROVIDER=mock
# EMAIL_HOST=smtp.example.com
# EMAIL_USER=user@example.com
# EMAIL_PASS=yourpassword

# Cloudinary (optional; falls back to local disk /uploads in dev)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# CORS (comma-separated list of allowed origins; in dev localhost origins auto-added)
CLIENT_URLS=http://localhost:5173
