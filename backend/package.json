{
  "name": "stocksense-backend",
  "version": "1.0.0",
  "description": "StockSense IMS Backend API",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.8.4",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "winston": "3.17.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.2",
    "nodemon": "3.1.9",
    "prettier": "3.4.2",
    "supertest": "7.0.0"
  }
}
